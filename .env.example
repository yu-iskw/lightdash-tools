# Copy to .env and fill in real values. Never commit .env.
LIGHTDASH_URL=https://app.lightdash.cloud
LIGHTDASH_API_KEY=ldpat_...

# Hosted OAuth (Compose / serve-http): public base URL for PRM, AS metadata, and Lightdash redirect.
# Local smoke: start `cloudflared tunnel --url http://127.0.0.1:3100`, paste the printed
# https://*.trycloudflare.com URL here, then recreate the mcp container.
# Register `{PUBLIC_URL}/oauth/callback` in Lightdash. Do not use free ngrok (interstitial breaks Cursor OAuth).
# LIGHTDASH_TOOLS_MCP_PUBLIC_URL=https://<your-subdomain>.trycloudflare.com
# LIGHTDASH_TOOLS_OAUTH_CLIENT_ID=
# LIGHTDASH_TOOLS_OAUTH_CLIENT_SECRET=

# Optional: enable the Compose profile without --profile on every command
# COMPOSE_PROFILES=semantic-layer

# Content-reader project scope when HTTP X-Lightdash-Project pin is absent (not used by semantic-layer get_project).
# LIGHTDASH_TOOLS_PROJECT_UUID=
