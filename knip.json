{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "packages/common/src/types/generated/openapi-types.ts": [
      "exports",
      "types",
      "nsExports",
      "nsTypes",
      "enumMembers",
      "namespaceMembers"
    ],
    "packages/common/src/types/v1/**": [
      "exports",
      "types",
      "nsExports",
      "nsTypes",
      "enumMembers",
      "namespaceMembers"
    ],
    "packages/common/src/types/v2/**": [
      "exports",
      "types",
      "nsExports",
      "nsTypes",
      "enumMembers",
      "namespaceMembers"
    ],
    "packages/common/src/types/lightdash-api.ts": [
      "exports",
      "types",
      "nsExports",
      "nsTypes",
      "enumMembers",
      "namespaceMembers"
    ],
    "packages/common/src/types/index.ts": [
      "exports",
      "types",
      "nsExports",
      "nsTypes",
      "enumMembers",
      "namespaceMembers"
    ]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs", "coverage-thresholds.mjs"],
      "project": ["scripts/**/*.mjs"],
      "vitest": {
        "config": ["vitest.config.ts"],
        "entry": ["packages/**/*.test.ts"]
      }
    },
    "packages/common": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["openapi-typescript"]
    },
    "packages/client": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/mcp": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/visualization": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
