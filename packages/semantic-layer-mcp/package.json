{
  "name": "@lightdash-tools/semantic-layer-mcp",
  "version": "0.6.0",
  "description": "MCP server for Lightdash semantic-layer discovery and query composition (compile only). MCP TypeScript SDK v2; stdio compatibility-first for Claude Code and Cursor.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lightdash-semantic-layer-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/resources && cp src/resources/playbook.md dist/resources/playbook.md",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "pnpm --dir ../.. exec vitest run packages/semantic-layer-mcp/src"
  },
  "dependencies": {
    "@lightdash-tools/client": "workspace:*",
    "@lightdash-tools/common": "workspace:*",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "^15.0.0",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3"
  }
}
