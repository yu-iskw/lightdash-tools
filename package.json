{
  "name": "@lightdash-tools",
  "version": "0.14.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "yu-iskw",
  "scripts": {
    "audit:all": "pnpm -r audit",
    "audit:fix": "pnpm -r audit --fix update",
    "prebuild": "pnpm validate:names",
    "build": "pnpm --recursive build",
    "format": "pnpm exec trunk fmt",
    "format:all": "pnpm format:trunk-all",
    "format:eslint": "eslint . --fix",
    "format:local": "pnpm format:eslint && pnpm format:prettier && pnpm format:package-json",
    "format:package-json": "sort-package-json package.json",
    "format:prettier": "prettier --write .",
    "format:trunk": "pnpm exec trunk fmt",
    "format:trunk-all": "pnpm exec trunk fmt --all",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "pnpm exec trunk check && pnpm knip && pnpm audit:all",
    "lint:all": "pnpm lint:trunk-all",
    "lint:eslint": "eslint .",
    "lint:local": "pnpm lint:package-json && pnpm lint:prettier && pnpm lint:eslint && pnpm knip",
    "lint:package-json": "sort-package-json --check package.json",
    "lint:prettier": "prettier --check .",
    "lint:security": "pnpm exec trunk check --all --scope security",
    "lint:trunk": "pnpm exec trunk check",
    "lint:trunk-all": "pnpm exec trunk check --all",
    "test": "vitest run --coverage",
    "test:fast": "vitest run",
    "trunk:install": "pnpm exec trunk install",
    "validate:deps": "node scripts/check-common-no-client.mjs",
    "validate:names": "node scripts/validate-package-names.mjs",
    "verify": "pnpm verify:pr",
    "verify:ci": "pnpm verify:pr && pnpm lint:trunk",
    "verify:pr": "pnpm validate:names && pnpm validate:deps && pnpm build && pnpm test && pnpm lint:local",
    "verify:quick": "pnpm build && pnpm test && pnpm lint:local"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@trunkio/launcher": "^1.3.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.5.3"
  }
}
