{
  "type": "workspace_readwrite",
  "enableSharedBuildCache": true,
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "github.com",
      "api.github.com",
      "codeload.github.com",
      "*.githubusercontent.com",
      "registry.npmjs.org",
      "nodejs.org",
      "*.trunk.io"
    ]
  }
}
